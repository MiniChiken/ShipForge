# ---------------------------------------------------------------------------
# Third-party and rights-holder content is deliberately NOT published here.
# This repo contains the tooling and the write-up only.
# ---------------------------------------------------------------------------

# Source model - Lucasfilm/Disney IP, obtained from Sketchfab. Not ours to
# redistribute. Supply your own .blend and point the scripts at it.
source/
*.blend
*.blend1

# Decompiled EVE client Python and any module derived from it - CCP's code.
decomp/
inject/
*_decompiled.py

# Third-party native authoring kit. Not ours to redistribute.
kit/

# Exported / compiled CCP static data. graphicids, types and typedogma dumps are
# game data, and the change sets and bundles embed cloned stock records.
*.jsonl
fsd_export*/
fsd_verify*/
fsd_work/
fsd_bundle/
fsd_project.json

# Localization pickles (CCP strings, ~200MB per language).
loc_out/
loc_request.json
loc_result.json

# Probe output - dumps of stock hull and table contents.
probe_*_result.json
*-author-result.json
native_out/
srv_*.json

# Measurements derived from the source model. Reproducible by re-running the
# Blender scripts against your own model; excluded for the same reason the
# model itself is.
deck.json
locators.json
mounts.json
lights.json
ellipsoid.json
icons/

# Generated by make_request.py from the measurements above.
venator_request.json

# ShipForge working state. Projects hold locator coordinates and local absolute
# paths, and a .probe.json embeds tens of thousands of vertices from the source
# model - excluded for the same reason the model is. seed_venator.py regenerates
# a project, and Import regenerates the probe.
shipforge/projects/
shipforge/runtime/
shipforge/shipforge_request.json
shipforge/shipforge_author_result.json
shipforge/shipforge_probe_request.json
shipforge/shipforge_probe_result.json
shipforge/snap_request.json
shipforge/snap_result.json

# liboodle - public domain (Unlicense) but a third-party repo; clone it yourself:
#   git clone https://github.com/LunaticInAHat/liboodle ref
ref/

# Derived/extracted game and model assets - CCP or Lucasfilm content, plus
# large intermediates that are reproducible from the pipeline.
*.gr2
*.dds
*.black
*.npy
*.glb
*.obj
*.fbx
*.png
*.jpg
venator_lod.bin
venator_lod.json
venator_mesh.bin
venator_mesh.json

# Build output and scratch
*.exe
*.obj
*.pdb
*.pyc
*.pyj
__pycache__/
_probe*
_sec*
_singlesided_check.gr2
